{
  "name": "shiloh-plugin",
  "description": "测试",
  "type": "module",
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "test": "npm run backend:test",
    "trace:report": "node scripts/turn-trace-report.mjs",
    "eval:tools": "node scripts/tool-exposure-eval.mjs",
    "persona:replay": "node scripts/personaReplay.mjs",
    "console:dev": "npm --prefix console/frontend run dev",
    "console:build": "npm --prefix console/frontend run build",
    "console:check": "npm --prefix console/frontend run typecheck",
    "console:test": "npm --prefix console/frontend test",
    "console:start": "node console/server.js",
    "console:smoke": "node tests/consoleFrontendSmoke.mjs",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.backend-tests.json --noEmit",
    "backend:build": "node scripts/backend-build.mjs",
    "backend:test": "node scripts/backend-test.mjs",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:artifacts": "node --test tests/backendArtifacts.test.js",
    "migration:report": "node scripts/migration-report.mjs",
    "verify:phase": "npm run backend:typecheck && npm run test:boundaries && npm test && npm run console:check && npm run console:test && npm run console:build && npm run migration:report",
    "release:pack": "node scripts/release.mjs pack",
    "release:verify": "node scripts/release.mjs verify"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "Yunzai-Bot",
    "shiloh-plugin"
  ],
  "author": "test",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^4.0.0",
    "@koa/router": "^12.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "axios": "^1.4.0",
    "chalk": "1.0.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fetch-undici": "^3.0.1",
    "form-data": "^4.0.0",
    "https-proxy-agent": "^7.0.4",
    "js-tiktoken": "^1.0.15",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.47",
    "keyv": "^4.5.2",
    "keyv-file": "^0.2.0",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.11",
    "mime-types": "^2.1.35",
    "moment": "^2.31.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.87.3",
    "p-limit": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "public-ip": "^6.0.1",
    "puppeteer": "^24.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "request": "^2.88.2",
    "sharp": "^0.33.5",
    "textract": "^2.5.0",
    "undici": "^5.22.1",
    "ws": "^8.13.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
